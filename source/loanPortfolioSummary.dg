void loanPortfolioSummary()
{
    summary = Map();
    summary.put("applications", Loan_Applications[ID != 0].count());
    summary.put("total_amount_inr", Loan_Applications[ID != 0].sum(Loan_Amount));
    summary.put("submitted", Loan_Applications[Status == "Submitted"].count());
    summary.put("under_review", Loan_Applications[Status == "Under Review"].count());
    summary.put("reviewed", Loan_Applications[Status == "Reviewed"].count());
    info summary;
}
